{
  "name": "happy-hours-reel",
  "version": "1.0.0",
  "description": "Vertical (9:16) 30 s reel for the MySalon.ma Happy Hours Beaut\u00e9 offers in T\u00e9mara (OYA MUSE + New Star Beauty), built with Remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render HappyHoursReel out/happy-hours-reel.mp4",
    "still": "remotion still HappyHoursReel out/cover.png --frame=40",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "music": "node scripts/make-music.mjs",
    "sfx": "node scripts/make-sfx.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/fonts": "4.0.522",
    "@remotion/media": "4.0.522",
    "@remotion/shapes": "4.0.522",
    "@remotion/transitions": "4.0.522",
    "@remotion/zod-types": "4.0.522",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.522",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.522",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
