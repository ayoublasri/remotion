{
  "name": "mysalon-invitation-reel",
  "version": "1.0.0",
  "description": "Vertical (9:16) 48 s story reel for salon owners: the MySalon.ma ad video, slowed, captioned, with drawn WhatsApp and check-in screens and an Afrobeats soundtrack (Remotion)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "prep": "node scripts/prep-video.mjs",
    "render": "remotion render InvitationReel out/mysalon-invitation-reel.mp4",
    "render:silent": "remotion render InvitationReel out/mysalon-invitation-reel-silent.mp4 --muted",
    "cover": "remotion still InvitationReel out/cover-hook.png --frame=40",
    "cover:end": "remotion still InvitationReel out/cover-end.png --frame=1420",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "music": "node scripts/make-music.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/fonts": "4.0.522",
    "@remotion/media": "4.0.522",
    "@remotion/shapes": "4.0.522",
    "@remotion/transitions": "4.0.522",
    "@remotion/zod-types": "4.0.522",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.522",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.522",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
